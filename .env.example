# ===== OBRIGATÓRIO =====
# Webhook do SEU canal do Discord:
# Configurações do canal > Integrações > Webhooks > Novo Webhook > Copiar URL
DISCORD_WEBHOOK=cole_seu_webhook_aqui

# ===== OPCIONAL =====
# Seu ID do Discord (pra receber @menção). Ative o Modo Desenvolvedor em
# Configurações > Avançado, depois clique no seu perfil > Copiar ID do usuário.
# Deixe vazio pra não mencionar ninguém.
DISCORD_USER_ID=

# Palavras que disparam o aviso, separadas por vírgula
PALAVRAS=evento,boss,spawn

# Área do chat dentro da janela do Roblox: esquerda,topo,direita,base
# Rode "python EventReader.py --teste" e confira o chat.png pra ajustar
AREA_CHAT=10,80,510,330

# Título da janela do jogo
TITULO_JANELA=Roblox

# Caminho do Tesseract, se não for o padrão
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
